# URL base del backend SGP (cambiar por entorno)
VITE_API_URL=http://localhost:8000/api/v1

# Modo desarrollo: activa MSW por defecto en dev
# (cambiar a 'false' para usar el backend real en lugar de mocks)
VITE_ENABLE_MSW=true

# Versión de la app (visible en sidebar y footer)
VITE_APP_VERSION=1.0.0
